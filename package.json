{
  "name": "proto-package",
  "version": "1.0.0",
  "description": "Proto package with proto definitions to import into multiple microservices",
  "main": "index.js",
  "scripts": {
    "lint:eslint": "eslint .  --config ./eslint.config.mjs",
    "lint:eslint:fix": "eslint .  --config ./eslint.config.mjs --fix",
    "lint:tsconfig": "tsc --project tsconfig.json --noEmit",
    "lint": "npm run lint:eslint && npm run lint:tsconfig",
    "test:server": "jest --config ./config/jest.config.js --runInBand",
    "start:server": "ts-node server/server.ts",
    "start:client": "make start",
    "mongo:docker": "docker compose up",
    "generate:js": "grpc_tools_node_protoc --js_out=import_style=commonjs:./build_ts --grpc_out=grpc_js:./build_ts --proto_path=./proto ./proto/*.proto",
    "generate:ts": "grpc_tools_node_protoc --plugin=protoc-gen-ts=./node_modules/.bin/protoc-gen-ts --ts_out=grpc_js:./build_ts --proto_path=./proto ./proto/*.proto",
    "cleanup": "rimraf ./build_ts && mkdirp ./build_ts",
    "generate:proto:ts": "npm run cleanup && npm run generate:js && npm run generate:ts"
  },
  "author": "Margarita",
  "license": "ISC",
  "dependencies": {
    "@grpc/grpc-js": "^1.11.3",
    "dotenv": "^16.4.7",
    "grpc_tools_node_protoc_ts": "^5.3.3",
    "grpc-tools": "^1.12.4",
    "mongodb": "^6.9.0",
    "ts-node": "^10.9.2",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.19.0",
    "@types/google-protobuf": "^3.15.12",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.1",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.23.0",
    "@typescript-eslint/parser": "^8.23.0",
    "eslint": "^9.19.0",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "mkdirp": "^3.0.1",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.5",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.23.0"
  }
}